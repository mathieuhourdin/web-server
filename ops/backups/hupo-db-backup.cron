# Install as /etc/cron.d/hupo-db-backup (root:root, 0644).
# The production VM was checked: its system timezone is Etc/UTC.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# /etc/cron.d entries include the execution user. 03:00 and 15:00 UTC.
0 3,15 * * * root /bin/bash -o pipefail -c '/usr/bin/timeout --signal=TERM --kill-after=60s 20m /usr/local/sbin/hupo-db-backup 2>&1 | /usr/bin/logger -t hupo-db-backup'
