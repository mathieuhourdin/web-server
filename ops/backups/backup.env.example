# Install as /etc/hupo-db-backup.env, owned by root with mode 0600.
# Never commit the real heartbeat URL or service-account credentials.
BACKUP_HEARTBEAT_URL=''
BACKUP_BUCKET='hupo-prod-db-backups'
BACKUP_COMPOSE_FILE='/home/mathieu/docker-compose.yml'
BACKUP_DB_SERVICE='db'
BACKUP_DB_USER='postgres'
BACKUP_DB_NAME='postgres'
# Keep this much disk free in addition to the maximum permitted dump size.
BACKUP_MIN_FREE_BYTES='2147483648'
